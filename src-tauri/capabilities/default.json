{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default DeskDash capabilities for Manager, Canvas, and Bar windows",
  "windows": ["manager", "canvas-*", "bar-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "opener:default",
    "dialog:default",
    "global-shortcut:default"
  ]
}
